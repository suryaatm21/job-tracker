  "pay_gate": {
    "_about": "Hard gate, applied only when a listing states pay; listings without pay, or with pay that cannot be parsed, pass to scoring. New grads are compared on the top of the posted yearly range (posted ranges are base only, no equity); interns on the hourly rate. Yearly and hourly convert at hours_per_year.",
    "enabled": true,
    "new_grad_min_yearly_usd": 140000,
    "intern_min_hourly_usd": 50,
    "hours_per_year": 2080
  },

  "role_gate": {
    "_about": "Hard gate on the kind of work (opportunity_filters.RoleGate has the order). Terms match whole words after lowercasing and turning punctuation into spaces, so 'Post-Silicon' matches 'silicon' and 'sales' never matches 'Salesforce'. Categories are the boards' own labels, compared exactly: Simplify's category field and zapply's section headings. speedyapply's sections (FAANG+, Quant, Other) group companies, not roles; its 'Quant' shares Simplify's label, which is harmless because that board lists only SWE roles.",
    "pm": {
      "_about": "PM titles drop even when they say technical or engineering. The Product categories drop unless the title has one of category_kept_when_title_has ('Product Engineer' stays).",
      "title_terms": ["product manager", "product managers", "product management", "associate product manager", "apm", "program manager", "program managers", "program management", "technical program manager", "tpm", "project manager", "project managers", "project management", "product owner"],
      "categories": ["Product", "Product Management"],
      "category_kept_when_title_has": ["engineer", "engineers", "engineering", "scientist", "software"]
    },
    "silicon": {
      "_about": "Chip-design work, dropped even when titled Engineer. Other hardware engineering stays.",
      "title_terms": ["silicon", "asic", "rtl", "vlsi", "design verification", "physical design", "dft", "design for test", "design for testability", "chip design", "ic design", "tapeout", "fab", "cleanroom"],
      "ignore_phrases": ["silicon valley", "non silicon"]
    },
    "non_engineering": {
      "_about": "always_drop_title_terms drop a listing whatever else the title says ('Engineering Technician', 'Embedded Account Executive'). A title_terms match drops it unless the title, with these terms cut out, still names an engineering role (role_terms below): 'Test and Launch Operations Engineer I' stays, 'Marketing Manager, AI' and 'Clinical Research Coordinator' drop. needs_qualifier_terms also need a qualifier_terms word in the rest: 'Software Engineer, Supply Chain' stays, 'Supply Chain Engineer' drops. The categories are zapply sections that mix in non-engineering work: they are title-checked, not absolute, so a listing there stays only when its title has an engineering title term ('Research Intern' stays, 'Supply Chain Internship' drops).",
      "needs_qualifier_terms": ["supply chain", "talent", "recruiting", "recruiter", "recruitment"],
      "qualifier_terms": ["software", "ml", "machine learning", "ai", "data"],
      "always_drop_title_terms": ["technician", "technicians", "security guard", "account executive", "sales engineer"],
      "categories": ["Business & Operations", "Other Jobs"],
      "title_terms": [
        "business", "business development", "operations", "ops", "strategy", "consulting", "consultant", "coordinator", "administrative",
        "supply chain", "logistics", "procurement", "sourcing", "purchasing", "buyer", "merchandising", "retail", "store", "branch",
        "talent", "recruiting", "recruiter", "recruitment", "human resources", "hr",
        "marketing", "market research", "brand", "communications", "public relations", "content", "social media",
        "sales", "account manager", "customer success",
        "finance", "financial", "accounting", "accountant", "audit", "tax", "treasury", "banking", "banker", "investment banking",
        "trader", "trading", "underwriter", "underwriting", "actuarial", "claims", "risk",
        "legal", "counsel", "paralegal", "attorney", "compliance",
        "nurse", "nursing", "pharmacist", "real estate", "facilities"
      ]
    },
    "engineering": {
      "role_terms": ["engineer", "engineers", "engineering", "developer", "developers", "scientist", "scientists", "researcher", "researchers"],
      "_about": "A listing must have one of these title terms or categories, unless its source sets engineering_only (the speedyapply boards list only SWE roles, so a generic title there stays). role_terms are the roles that rescue a title with a non-engineering term. Trading titles are not research: 'Quantitative Trader' drops via 'trader'.",
      "categories": ["Software", "Software Engineering", "AI/ML/Data", "Data Science, AI & Machine Learning", "Quant", "Quantitative Finance", "Hardware", "Hardware & Systems Engineering", "Security Engineering", "Data, AI & Research"],
      "title_terms": [
        "engineer", "engineers", "engineering", "developer", "developers", "software", "programmer", "swe", "sde", "technical staff",
        "machine learning", "ml", "ai", "artificial intelligence", "deep learning", "computer vision", "nlp", "llm",
        "data science", "data scientist", "scientist", "scientists", "research", "researcher", "researchers", "r&d",
        "quant research", "quant researcher", "quantitative research", "quantitative researcher", "quant developer", "quantitative developer",
        "devops", "devsecops", "mlops", "sre", "site reliability", "firmware", "embedded", "fpga", "robotics", "security", "cybersecurity",
        "computer science", "programming", "full stack", "fullstack", "frontend", "backend", "sdet", "applied science",
        "web development", "application development", "software development", "system development", "systems development"
      ]
    }
  },

  "scoring": {
    "strong_threshold": 3,
    "graduate_only_points": -6,
    "funding": {
